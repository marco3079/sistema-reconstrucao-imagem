# Os valores abaixo são exemplos.
# O instalador (instalar.ps1 ou instalar.sh) cria o .env com segredos aleatórios.
# Se copiar este arquivo para .env na mão, troque POSTGRES_PASSWORD, JWT_SECRET e AGENTES_TOKEN.

# Senha do banco PostgreSQL
POSTGRES_PASSWORD=restaura
# Segredo usado para assinar os logins (JWT) e cifrar os tokens do Canva
JWT_SECRET=troque-este-segredo-de-exemplo
# Token da equipe de agentes (sessão do Claude Code ligada por MCP). 32 caracteres ou mais.
AGENTES_TOKEN=troque-este-token-dos-agentes
# Conta de administrador criada na primeira subida
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@restaura.local
# Senha inicial do administrador (padrão: admin1234); troque em Meu perfil depois do primeiro acesso
ADMIN_SENHA=admin1234
# Porta do site no computador
WEB_PORT=8095
# Porta da API e do servidor MCP no computador (publicada só em 127.0.0.1)
API_PORT=3095
# Porta do banco no computador (publicada só em 127.0.0.1)
DB_PORT=5435
# Endereço do site como você abre no navegador (o Canva devolve o login para ele)
URL_PUBLICA=http://localhost:8095
# Fuso horário da API
FUSO_HORARIO=America/Sao_Paulo
