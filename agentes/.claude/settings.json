{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "mcp__restaura"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/laco.js", "prompt"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/laco.js", "parar"]
          }
        ]
      }
    ]
  }
}
